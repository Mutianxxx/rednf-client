# 构建与运行产物：可重建，不入库
checkpoints/
reports/
cache/

# 工具脚本目录，名字与产物目录同名，需显式保留
!project/tools/checkpoints/
project/cache/
project/build/
project/saves/
project/reports/
project/work/
project/checkpoints/
delivery/

# 一次性临时产物区：测试夹具、诊断 JSON、reports、content 缓存
temp-project-dir/

# 编译中间件与调试符号（第三方预编译依赖如 SDL2 的 .a/.dll 仍入库）
*.pdb
*.ilk
*.exp
*.obj
*.o

# Python 与工具缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 编辑器与本机配置
.vscode/
.idea/
*.user
*.suo
*.log
