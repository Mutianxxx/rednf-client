  "arithmetic": {
    "refresh": "f32(Sani * f32(0.1))",
    "installation": "f32(f32(Sani) * G * f32(0.001))",
    "deadline": "nextDeadline -= trunc(decodedDelay / rate * f32(-100))",
    "total_duration_separate": "sum(trunc(decodedDelay * (1/rate) * f32(100)))",
    "rate_change": "trunc(oldElapsed / newRate * oldRate)",
